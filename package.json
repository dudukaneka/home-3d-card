{
  "name": "home-3d-card",
  "version": "0.5.1",
  "private": false,
  "description": "Custom Home Assistant Lovelace 3D Dashboard Card with click-to-maximize area sensors and appliances",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ci": "npm run typecheck && npm run build && npm run validate:model",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:model": "node scripts/validate-glb.mjs examples/sample-home/sample-home.glb examples/sample-home/areas.json"
  },
  "dependencies": {
    "lit": "^3.2.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.6"
  }
}
